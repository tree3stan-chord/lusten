{
  "crons": [
    {
      "path": "/api/cron/refresh-spotify-stats",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/refresh-spotify-stats/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/refresh-spotify-stats/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/users/[spotifyId]/spotify-stats/route.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "ADMIN_API_KEY": "@admin_api_key",
    "CRON_SECRET": "@cron_secret", 
    "REFRESH_TOKEN_ENCRYPTION_KEY": "@refresh_token_encryption_key"
  }
}